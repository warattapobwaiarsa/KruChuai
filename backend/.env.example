# ==========================================
# KruChuai (ครูช่วยร่าง) Configuration
# ==========================================

# Google Gemini API Key (ใส่ Key เพื่อใช้ AI จริง หรือปล่อยว่างเพื่อใช้ Heuristic Fallback)
GEMINI_API_KEY=

# OpenAI API Key (ตัวเลือกเสริม)
OPENAI_API_KEY=

# Database Connection (ค่าเริ่มต้นสำหรับ Docker PostgreSQL หรือ SQLite ภายในเครื่อง)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/kruchuai
# สำหรับการรัน Local ทั่วไปโดยไม่ใช้ Docker สามารถใช้ SQLite ได้:
# DATABASE_URL=sqlite:///./kruchuai.db

# Redis Connection
REDIS_URL=redis://localhost:6379/0
